{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claudenovel Branch Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "branch_id",
    "core_mechanism",
    "premise_difference",
    "character_choice",
    "real_cost",
    "world_rule_usage",
    "beats",
    "freedom_budget_choices",
    "idea_lock_evidence",
    "forbidden_change_checks",
    "risk_register"
  ],
  "properties": {
    "schema_version": {"const": "branch-card/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "pattern": "^branch_0[1-3]$"},
    "core_mechanism": {"type": "string", "minLength": 8},
    "premise_difference": {"type": "string", "minLength": 8},
    "character_choice": {"type": "string", "minLength": 8},
    "real_cost": {"type": "string", "minLength": 4},
    "world_rule_usage": {
      "oneOf": [
        {"type": "string", "minLength": 8},
        {"type": "array", "minItems": 1},
        {"type": "object", "minProperties": 1}
      ]
    },
    "beats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "escalation", "irreversible_choice", "local_payoff", "end_hook"],
      "properties": {
        "setup": {"type": "string", "minLength": 6},
        "escalation": {"type": "string", "minLength": 6},
        "irreversible_choice": {"type": "string", "minLength": 6},
        "local_payoff": {"type": "string", "minLength": 6},
        "end_hook": {"type": "string", "minLength": 6}
      }
    },
    "freedom_budget_choices": {
      "oneOf": [
        {"type": "array", "minItems": 2},
        {"type": "object", "minProperties": 2}
      ]
    },
    "idea_lock_evidence": {
      "oneOf": [
        {"type": "array", "minItems": 1},
        {"type": "object", "minProperties": 1}
      ]
    },
    "forbidden_change_checks": {
      "oneOf": [
        {"type": "array"},
        {"type": "object"}
      ]
    },
    "risk_register": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 4}}
  }
}
